[Unit]
Description=Music Ideas web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/music-ideas
EnvironmentFile=/home/admin/music-ideas/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/admin/music-ideas/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
MemoryMax=512M
CPUQuota=60%
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
